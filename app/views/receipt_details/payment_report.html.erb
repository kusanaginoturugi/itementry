<% content_for :title, "入金報告書記載用" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h4 mb-0">入金報告書記載用</h1>
  <% unless request.format.pdf? %>
    <div class="d-flex gap-2 align-items-center pdf-hide">
      <%= form_with url: payment_report_receipt_details_path, method: :get, local: true, class: "d-flex gap-2" do |form| %>
        <%= form.label :book_id, "帳票", class: "form-label mb-0 align-self-center" %>
        <%= form.select :book_id,
              options_from_collection_for_select(@books, :id, :title, params.key?(:book_id) ? params[:book_id] : @selected_book_id),
              { include_blank: "すべて" },
              class: "form-select form-select-sm" %>
        <%= form.submit "適用", class: "btn btn-outline-secondary btn-sm" %>
      <% end %>
      <%= link_to "CSV出力", payment_report_receipt_details_path(request.query_parameters.merge(format: :csv)), class: "btn btn-outline-secondary btn-sm" %>
      <%= link_to "PDF出力", payment_report_receipt_details_path(request.query_parameters.merge(format: :pdf)), class: "btn btn-outline-primary btn-sm" %>
    </div>
  <% end %>
</div>

<% if request.format.pdf? %>
  <style>
    .navbar, .pdf-hide { display: none !important; }
  </style>
  <% if defined?(wicked_pdf_stylesheet_link_tag) %>
    <%= wicked_pdf_stylesheet_link_tag "pdf" %>
  <% end %>
<% end %>

<div class="card shadow-sm">
  <div class="card-body p-0">
    <table class="table table-bordered mb-0 align-middle">
      <thead class="table-light text-center">
        <tr>
          <th rowspan="2" class="text-start">《入金報告書記載用》</th>
          <th colspan="2">護摩センター</th>
          <th colspan="2">祈願会・内陣奉ト占</th>
          <th colspan="2">報告書記載額</th>
        </tr>
        <tr>
          <th>数</th>
          <th>金額</th>
          <th>数</th>
          <th>金額</th>
          <th>数</th>
          <th>金額</th>
        </tr>
      </thead>
      <tbody>
        <% @payment_report_rows.each do |row| %>
          <tr>
            <td><%= row[:group].name %></td>
            <td class="text-end"><%= number_with_delimiter(row[:center_count]) %></td>
            <td class="text-end"><%= number_with_delimiter(row[:center_value]) %></td>
            <td class="text-end"><%= number_with_delimiter(row[:prayer_count]) %></td>
            <td class="text-end"><%= number_with_delimiter(row[:prayer_value]) %></td>
            <td class="text-end"><%= number_with_delimiter(row[:center_count] + row[:prayer_count]) %></td>
            <td class="text-end"><%= number_with_delimiter(row[:center_value] + row[:prayer_value]) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="table-light fw-bold">
        <tr>
          <td>合計</td>
          <td class="text-end"><%= number_with_delimiter(@payment_report_rows.sum { |row| row[:center_count] }) %></td>
          <td class="text-end"><%= number_with_delimiter(@payment_report_rows.sum { |row| row[:center_value] }) %></td>
          <td class="text-end"><%= number_with_delimiter(@payment_report_rows.sum { |row| row[:prayer_count] }) %></td>
          <td class="text-end"><%= number_with_delimiter(@payment_report_rows.sum { |row| row[:prayer_value] }) %></td>
          <td class="text-end"><%= number_with_delimiter(@payment_report_rows.sum { |row| row[:center_count] + row[:prayer_count] }) %></td>
          <td class="text-end"><%= number_to_currency(@payment_report_rows.sum { |row| row[:center_value] + row[:prayer_value] }, unit: "¥", precision: 0) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>
