<% content_for :title, @item.name %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h4 mb-1"><%= @item.name %></h1>
    <div class="text-muted">道具ID: <%= @item.id %></div>
  </div>
  <div class="btn-group">
    <%= link_to "一覧へ戻る", items_path, class: "btn btn-outline-secondary" %>
    <%= link_to "編集", edit_item_path(@item), class: "btn btn-primary" %>
    <% if @item.is_active? %>
      <%= button_to "無効化", @item, method: :delete, form: { data: { turbo_confirm: "#{@item.name}を候補から外しますか？" } }, class: "btn btn-danger" %>
    <% else %>
      <%= button_to "有効化", activate_item_path(@item), method: :patch, class: "btn btn-success" %>
    <% end %>
  </div>
</div>

<%= render @item %>
